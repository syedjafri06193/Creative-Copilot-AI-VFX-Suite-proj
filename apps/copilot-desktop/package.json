{
  "name": "@sensei/copilot-desktop",
  "version": "0.1.0",
  "description": "SENSEI desktop copilot UI",
  "private": true,
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5180 --strictPort\" \"electron . --dev\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && node scripts/package.mjs",
    "typecheck": "tsc -p . && tsc -p tsconfig.electron.json"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.19.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-winstaller": "^5.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.3"
  }
}
